# Equa Backend — Ortam Değişkenleri Şablonu
# Bu dosyayı kopyalayıp ".env" olarak kaydet:
#   cp .env.example .env
# .env asla Git'e commit edilmez!

# --- Veritabanı ---
DATABASE_URL=postgresql+asyncpg://equa:equa_dev@localhost:5432/equa

# --- Güvenlik ---
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- LLM / AI (A1) ---
# Desteklenen sağlayıcılar: openai | anthropic | bedrock
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Anthropic örnek model: claude-3-haiku-20240307
# Bedrock örnek model: anthropic.claude-3-haiku-20240307-v1:0

# --- Tenant ---
# MVP'de JWT yokken header ile tenant context set edilir.
# Örnek: X-Tenant-Id: tenant_uuid_burada
DEFAULT_TENANT_HEADER=X-Tenant-Id

# --- Loglama ---
LOG_LEVEL=debug

# --- Uygulama ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
