# Equa Backend — Ortam Değişkenleri Şablonu
# Bu dosyayı kopyalayıp ".env" olarak kaydet:
#   cp .env.example .env
# .env asla Git'e commit edilmez!

# --- Veritabanı ---
DATABASE_URL=postgresql+asyncpg://equa:equa_dev@localhost:5433/equa

# --- Güvenlik ---
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- LLM / AI (A1) ---
# Desteklenen sağlayıcılar: gemini | openai | anthropic | bedrock
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Gemini örnek: gemini-3.5-flash-lite | gemini-flash-lite-latest | gemini-3.6-flash
# OpenAI örnek: gpt-4o-mini
# Anthropic örnek: claude-3-haiku-20240307
# Bedrock örnek: anthropic.claude-3-haiku-20240307-v1:0

# --- Tenant ---
# MVP'de JWT yokken header ile tenant context set edilir.
# Örnek: X-Tenant-Id: tenant_uuid_burada
DEFAULT_TENANT_HEADER=X-Tenant-Id

# --- Loglama ---
LOG_LEVEL=debug

# --- Uygulama ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# --- LinkedIn PDF (S10–S12) ---
# MVP: in-memory parse (no S3). Max 10 MB; .pdf / .txt only.
# Production: set APP_ENV=production and a strong JWT_SECRET (≥32 chars);
# DATABASE_URL must not use localhost/equa_dev defaults.
